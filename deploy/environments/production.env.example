NODE_ENV=production
DATABASE_URL=postgresql://lunch_app:SET_IN_SECRET_MANAGER@PRODUCTION_DB_PRIVATE_HOST:5432/lunch?schema=public&sslmode=require&connection_limit=10&pool_timeout=20
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=https://lunch.example.com
API_TRUST_PROXY_HOPS=1
CORS_ORIGINS=https://lunch.example.com
JWT_ACCESS_SECRET=SET_IN_SECRET_MANAGER
JWT_REFRESH_SECRET=SET_IN_SECRET_MANAGER
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12
LOG_LEVEL=info
DELIVERY_OTP_SECRET=SET_IN_SECRET_MANAGER
DELIVERY_OTP_TTL_MINUTES=30
DELIVERY_OTP_MAX_ATTEMPTS=5
TRACKING_WORKER_ENABLED=true
TRACKING_LATE_GRACE_MINUTES=5
NOTIFICATION_PROVIDER=gateway
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_GATEWAY_URL=https://notifications.example.com/api
NOTIFICATION_GATEWAY_TOKEN=SET_IN_SECRET_MANAGER
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=SET_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=SET_IN_SECRET_MANAGER
RAZORPAY_WEBHOOK_SECRET=SET_IN_SECRET_MANAGER
SENTRY_DSN=SET_PRODUCTION_DSN
API_INTERNAL_URL=http://api:4000
NEXT_PUBLIC_APP_NAME=Lunch
