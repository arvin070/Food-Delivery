# ─── Shared ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev DB is managed by `npm run db:start` (embedded Postgres, no Docker).
DATABASE_URL="postgresql://lunch:lunch@127.0.0.1:55432/lunch?schema=public"

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
# Public base URL of the API (used in links sent to users)
API_PUBLIC_URL=http://localhost:4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-dev-access-secret-change-me-change-me
JWT_REFRESH_SECRET=change-me-dev-refresh-secret-change-me-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

BCRYPT_ROUNDS=10
LOG_LEVEL=debug

# Delivery OTP
DELIVERY_OTP_TTL_MINUTES=30
# Required in production; set a distinct random secret of at least 32 characters.
# DELIVERY_OTP_SECRET=
DELIVERY_OTP_MAX_ATTEMPTS=5

# ─── Payments ─────────────────────────────────────────────────────────────────
# mock | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional development/test webhook signing secret. Mock mode is forbidden in production.
MOCK_PAYMENT_WEBHOOK_SECRET=

# ─── Web ──────────────────────────────────────────────────────────────────────
# Server-side URL the Next.js server uses to reach the API
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Lunch


# In-app notifications always work. External channels require an adapter/gateway.
NOTIFICATION_PROVIDER=disabled
NOTIFICATION_WORKER_ENABLED=true
# NOTIFICATION_GATEWAY_URL=https://your-gateway.example/messages
# NOTIFICATION_GATEWAY_TOKEN=replace-with-a-long-secret

# Only trust forwarding headers from an enforced, known reverse-proxy topology.
API_TRUST_PROXY_HOPS=0
